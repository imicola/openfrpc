{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFrpc",
  "version": "0.1.0",
  "identifier": "com.zhaochenxi.openfrpc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenFrpc — frp 控制台",
        "width": 1240,
        "height": 830,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
